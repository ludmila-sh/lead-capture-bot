# Telegram bot token from BotFather
BOT_TOKEN=your-token-here

# Public username of the expert to hand off warm leads to (without @)
EXPERT_HANDOFF_USERNAME=expert_username

# Invite link or public URL of the Telegram channel to funnel subscribers into
CHANNEL_URL=https://t.me/your_channel

# Optional. Numeric channel id (e.g. -1001234567890) for subscription tracking.
# Needed only for a PRIVATE channel; for a public one the @username from
# CHANNEL_URL is used. The bot must be an admin in the channel either way.
# Get it: forward a channel post to @userinfobot, or check the bot's console log
# line "bot membership in ... (id=...)" after adding it as admin.
CHANNEL_ID=

# Optional. Numeric chat id of the expert so the bot can send them lead
# notifications. Get it by messaging @userinfobot from the expert's account.
# If left empty, handoff still works — the user just receives the link.
EXPERT_CHAT_ID=

# Optional. Path (relative to repo root) for the interaction event log.
# Defaults to data/interactions.jsonl
INTERACTION_LOG_PATH=

# --- Google Sheets analytics (Phase 4) -----------------------------------
# Optional. Mirror funnel milestones (start / magnet_delivered / handoff) into
# a Google Sheet. Active only when both the key path and spreadsheet id are set;
# otherwise the bot just keeps the local JSONL log. See README.
#
# Path to the service-account JSON key (keep it out of git — use secrets/).
GOOGLE_SERVICE_ACCOUNT_JSON=
# Spreadsheet id — the long token in the sheet URL between /d/ and /edit.
ANALYTICS_SPREADSHEET_ID=
# Worksheet (tab) name to append rows to. Defaults to "events".
ANALYTICS_WORKSHEET=
